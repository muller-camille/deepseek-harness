{
  "manifest_version": 3,
  "name": "DeepSeek Harness browser bridge",
  "version": "0.2.3",
  "description": "Lets a DeepSeek Harness agent open, read, and operate pages in this Chrome, only on sites you allow.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage", "tabGroups"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "DeepSeek Harness browser bridge",
    "default_popup": "options.html"
  }
}
